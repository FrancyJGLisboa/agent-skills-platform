{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Skills",
  "version": "0.3.0",
  "identifier": "io.github.francyjglisboa.agent-skills",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Agent Skills",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/skill_registry"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVGNTY3OTc1MDg2QzU3QjEKUldTeFYyd0lkWGxXWCtjZFFOTFY2dmlvbCs4RzdXaWQ3S1hwOFZ6d1dkSUd4aGZkazJ5Sy9odnoK",
      "endpoints": [
        "https://github.com/FrancyJGLisboa/agent-skills-platform/releases/latest/download/latest.json"
      ]
    }
  }
}
